# Astral Zero — environment template
# Copy to `.env` and tweak for local development:
#   cp .env.example .env

# HTTP + Socket.io port (backend opens http://localhost:<PORT>)
# NOTE: the Vite game dev server is separate (`npm run dev` → :5173).
PORT=3000

# Socket.io CORS origin. "*" = accept Phaser from any origin (dev).
# The Vite game on :5173 talking to the backend on :3000 IS cross-origin,
# so keep "*" locally. Production example: CORS_ORIGIN=https://astral-zero.example.com
CORS_ORIGIN=*

# Optional: override static hosting roots (see src/server-config.js).
# DIST_DIR = Vite build output, served if present (`npm run build` creates it).
# PUBLIC_DIR = Vite static assets, always served.
# DIST_DIR=./dist
# PUBLIC_DIR=./public
