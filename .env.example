# Debris Derby — environment template
# Copy to `.env` and adjust for local development:
#   cp .env.example .env

# HTTP + Socket.io port (backend).
# The Vite dev server is separate (`npm run dev` → :5173) and proxies to this.
PORT=3000

# Socket.io CORS origin. "*" is fine locally.
# Production example: CORS_ORIGIN=https://debris-derby.example.com
CORS_ORIGIN=*

# Optional static roots (see src/server-config.js).
# DIST_DIR is the Vite build output; PUBLIC_DIR is always served.
# DIST_DIR=./dist
# PUBLIC_DIR=./public

# Celestrak is fetched without an API key from:
#   https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=json
# There is no fallback TLE file and no offline mode. If Celestrak is
# unreachable, the server logs loudly and marks the catalog stale/unavailable.

# There are no secrets or database credentials. The leaderboard is in-memory
# and resets on restart. Do not commit a real `.env`.
