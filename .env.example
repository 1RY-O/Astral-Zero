# ASTRAL ZERO — Environment Configuration Template
# Built for the NASA International Space Apps Challenge 2026.
# Copy to `.env` for local development:
#   cp .env.example .env

# ==============================================================================
# SERVER CONFIGURATION (Render / Node.js)
# ==============================================================================

# Port the Express + Socket.io server listens on
PORT=3000

# Node runtime environment ('development' | 'production')
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# Development: http://localhost:5173,http://127.0.0.1:5173
# Production:  https://astral-zero.vercel.app,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Rate Limiter threshold (requests per minute per IP)
RATE_LIMIT_MAX_PER_MINUTE=100

# ==============================================================================
# CLIENT CONFIGURATION (Vercel / Vite SPA)
# ==============================================================================

# URL of the deployed Render backend service.
# Development: http://localhost:3000
# Production:  https://astral-zero-server.onrender.com
VITE_SERVER_URL=http://localhost:3000

# Enable diagnostic telemetry overlay in client HUD ('true' | 'false')
VITE_ENABLE_DIAGNOSTICS=false
