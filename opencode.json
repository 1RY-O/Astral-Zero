{
  "mcp": {
    "servers": {
      "figma": {
        "type": "local",
        "command": ["npx", "opencode-figma-mcp"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium",
          "--executable-path",
          "/usr/bin/chromium",
          "--headless",
          "--no-sandbox",
          "--output-dir",
          "/tmp/opencode"
        ]
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      }
    }
  }
}
